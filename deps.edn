{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}}
 :aliases
 {:test {:extra-paths ["test"]
         :main-opts ["-m" "datomic-opensource.test-runner"]}
  :transactor {:main-opts ["-m" "datomic-opensource.transactor"]}
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.6" :git/sha "52cf7d6"}}
          :ns-default build}
  :deploy {:deps {slipset/deps-deploy {:mvn/version "0.2.2"}}
           :ns-default deploy}}}
