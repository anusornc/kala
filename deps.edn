{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}}
 :aliases
 {:test {:extra-paths ["test" "mcp"]
         :extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
         :main-opts ["-m" "kala.test-runner"]}
  :mcp {:extra-paths ["mcp"]
        :extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
        :main-opts ["-m" "kala.mcp"]}
  :demo {:extra-paths ["demo"]
         :main-opts ["-m" "kala.demo"]}
  :web {:extra-paths ["web" "web/public"]
        :main-opts ["-m" "kala.web"]}
  :e2e {:extra-paths ["e2e"]
        :main-opts ["-m" "kala.e2e.client-journey"]}
  :transactor {:main-opts ["-m" "kala.transactor"]}
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.6" :git/sha "52cf7d6"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}}
          :ns-default build}
  :bench {:extra-paths ["bench"]
          :extra-deps {datascript/datascript {:mvn/version "1.7.4"
                                              ;; datahike forks pss under io.replikativ and
                                              ;; needs its 3-arg replace; one pss jar only
                                              :exclusions [persistent-sorted-set/persistent-sorted-set]}
                       io.replikativ/datahike {:mvn/version "0.7.1624"}
                       io.replikativ/persistent-sorted-set {:mvn/version "0.3.116"}}
          :main-opts ["-m" "kala.bench"]}
  :bench-datomic {:extra-paths ["bench"]
                  :extra-deps {datascript/datascript {:mvn/version "1.7.4"}
                               com.datomic/peer {:mvn/version "1.0.7387"}}
                  :main-opts ["-m" "kala.bench"]}}}
